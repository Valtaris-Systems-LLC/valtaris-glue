// supabase/functions/aggregate-job-step-metrics/index.ts
// Valtaris Glue — Job & Step Metrics Aggregator (Generation 3)
//
// This file aggregates raw job + step metrics into:
//   - avg job duration
//   - avg step duration
//   - p95 step latency
//   - job error rate
//   - step error rate
//   - job success rate
//   - step success rate
//   - reliability scoring
//
// Authority chain:
//   collect-metrics → aggregate-job-step-metrics → workflow_job_step_aggregates
//
// This file NEVER:
//   - mutates workflow_runs
//   - mutates workflow_versions
//   - executes connectors
//   - schedules jobs
//   - bypasses RLS

import { serve } from "https://deno.land/std@0.168.0/http/server.ts";
import { createClient } from "https://esm.sh/@supabase/supabase-js@2";

const supabase = createClient(
  Deno.env.get("SUPABASE_URL")!,
  Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!
);

const NOW = () => new Date().toISOString();

// ------------------------------------------------------------
// Aggregation Window
// ------------------------------------------------------------

const WINDOW_MINUTES = 5; // 5‑minute rolling window

function windowStart() {
  return new Date(Date.now() - WINDOW_MINUTES * 60 * 1000).toISOString();
}

// ------------------------------------------------------------
// Main Handler
// ------------------------------------------------------------

serve(async () => {
  try {
    const start = windowStart();

    // Load raw metrics for the window
    const { data: metrics, error } = await supabase
      .from("workflow_metrics")
      .select("*")
      .gte("created_at", start);

    if (error) {
      return jsonError("load-metrics-failed", 500, error);
    }

    if (!metrics || metrics.length === 0) {
      return jsonOK({
        status: "no-metrics",
        window_start: start,
      });
    }

    // Group by job_id + step_id
    const grouped: Record<string, any[]> = {};
    for (const m of metrics) {
      const key = `${m.job_id ?? "unknown"}::${m.step_id ?? "unknown"}`;
      if (!grouped[key]) grouped[key] = [];
      grouped[key].push(m);
    }

    // Aggregate each job/step pair
    const aggregates = [];
    for (const key of Object.keys(grouped)) {
      const rows = grouped[key];
      const [job_id, step_id] = key.split("::");

      const durations = rows
        .map((r) => r.duration_ms)
        .filter((d) => typeof d === "number");

      const errors = rows.filter((r) => r.error);
      const successes = rows.filter((r) => !r.error);

      const avgDuration =
        durations.length > 0
          ? durations.reduce((a, b) => a + b, 0) / durations.length
          : null;

      const p95Latency =
        durations.length > 0
          ? percentile(durations, 95)
          : null;

      const errorRate = rows.length > 0 ? errors.length / rows.length : 0;
      const successRate = rows.length > 0 ? successes.length / rows.length : 0;

      const reliabilityScore = computeReliability(successRate, p95Latency);

      aggregates.push({
        job_id,
        step_id,
        window_start: start,
        window_end: NOW(),
        call_count: rows.length,
        avg_duration_ms: avgDuration,
        p95_latency_ms: p95Latency,
        error_rate,
        success_rate,
        reliability_score: reliabilityScore,
        created_at: NOW(),
      });
    }

    // Insert aggregates
    const { error: insertErr } = await supabase
      .from("workflow_job_step_aggregates")
      .insert(aggregates);

    if (insertErr) {
      return jsonError("insert-aggregates-failed", 500, insertErr);
    }

    return jsonOK({
      status: "aggregated",
      window_start: start,
      pairs: aggregates.length,
    });
  } catch (err) {
    return jsonError("aggregate-job-step-metrics-failed", 500, String(err));
  }
});

// ------------------------------------------------------------
// Helpers
// ------------------------------------------------------------

function percentile(arr: number[], p: number) {
  const sorted = [...arr].sort((a, b) => a - b);
  const idx = Math.ceil((p / 100) * sorted.length) - 1;
  return sorted[Math.max(0, idx)];
}

function computeReliability(successRate: number, p95Latency: number | null) {
  if (p95Latency === null) return successRate;
  const latencyPenalty = Math.min(p95Latency / 5000, 1); // 5s cap
  return Math.max(0, successRate - latencyPenalty);
}

function jsonOK(obj: any) {
  return new Response(JSON.stringify(obj), {
    status: 200,
    headers: { "Content-Type": "application/json" },
  });
}

function jsonError(code: string, status: number, details?: any) {
  return new Response(
    JSON.stringify({
      error: code,
      details,
    }),
    {
      status,
      headers: { "Content-Type": "application/json" },
    }
  );
}
