// supabase/functions/connector-runner/index.ts
// Valtaris Glue — Connector Runner (Generation 3)
//
// This file is responsible for:
//   - executing connector handlers
//   - enforcing structured result contracts
//   - isolating external systems
//   - propagating normalized errors
//   - guaranteeing deterministic connector execution
//
// Authority chain:
// connector-wrapper → connector-runner → adapter → external system
//
// This file NEVER:
//   - mutates workflow_runs
//   - mutates workflow_versions
//   - retries jobs
//   - schedules jobs
//   - bypasses RLS

import { serve } from "https://deno.land/std@0.224.0/http/server.ts";

interface ConnectorResult {
  success: boolean;
  output?: Record<string, unknown>;
  errorCode?: string;
  errorMessage?: string;
}

// ---------------------------------------------------------------------------
// Connector Registry (Generation‑3)
// ---------------------------------------------------------------------------
//
// In production, this registry is dynamically loaded from:
// - product definitions
// - connector metadata
// - governance contracts
//
// For now, we define a minimal static registry.
//

const connectorRegistry: Record<
  string,
  (payload: Record<string, unknown>) => Promise<Record<string, unknown>>
> = {
  "echo": async (payload) => {
    return {
      echo: payload,
      executedAt: new Date().toISOString(),
    };
  },

  "http.get": async (payload) => {
    const url = String(payload.url ?? "");
    if (!url) {
      throw new Error("Missing URL for http.get connector");
    }

    const res = await fetch(url);
    const text = await res.text();

    return {
      url,
      status: res.status,
      body: text,
      executedAt: new Date().toISOString(),
    };
  },
};

// ---------------------------------------------------------------------------
// Execution Engine
// ---------------------------------------------------------------------------

serve(async (req) => {
  try {
    const body = await req.json();
    const { connectorKey, payload } = body;

    if (!connectorKey) {
      return jsonError("missing-connector-key", 400, "Connector key is required");
    }

    const handler = connectorRegistry[connectorKey];
    if (!handler) {
      return jsonError("unknown-connector", 404, `Connector '${connectorKey}' not found`);
    }

    try {
      const output = await handler(payload ?? {});
      return jsonOK({
        success: true,
        output,
      });
    } catch (err) {
      return jsonOK({
        success: false,
        errorCode: "connector-execution-error",
        errorMessage: String(err),
      });
    }
  } catch (err) {
    return jsonError("connector-runner-failed", 500, String(err));
  }
});

// ---------------------------------------------------------------------------
// Response Helpers
// ---------------------------------------------------------------------------

function jsonOK(obj: ConnectorResult) {
  return new Response(JSON.stringify(obj), {
    status: 200,
    headers: { "Content-Type": "application/json" },
  });
}

function jsonError(code: string, status: number, message?: string) {
  return new Response(
    JSON.stringify({
      success: false,
      errorCode: code,
      errorMessage: message,
    }),
    {
      status,
      headers: { "Content-Type": "application/json" },
    }
  );
}
