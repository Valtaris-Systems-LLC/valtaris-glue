// supabase/functions/connector-runner/index.ts
// Valtaris Glue — Connector Runner
//
// This Edge Function executes a single connector call.
// It is invoked by the worker runtime and provides:
// - connector registry lookup
// - safe execution sandbox
// - structured error propagation
// - normalized input/output shapes
// - consistent connector result contract

import { serve } from "https://deno.land/std@0.224.0/http/server.ts";

interface ConnectorContext {
  connectorKey: string;
  payload: Record<string, unknown>;
}

interface ConnectorResult {
  success: boolean;
  output?: Record<string, unknown>;
  errorCode?: string;
  errorMessage?: string;
}

//
// ---------------------------------------------------------------------------
// Connector Registry
// ---------------------------------------------------------------------------
//
// In a full implementation, this registry would be dynamically loaded from
// product definitions, connector metadata, or Nucleus governance contracts.
// For now, we define a simple static registry.
//

const connectorRegistry: Record<
  string,
  (payload: Record<string, unknown>) => Promise<Record<string, unknown>>
> = {
  "echo": async (payload) => {
    return {
      echo: payload,
      executedAt: new Date().toISOString(),
    };
  },

  "http.get": async (payload) => {
    const url = String(payload.url ?? "");
    if (!url) {
      throw new Error("Missing URL for http.get connector");
    }

    const res = await fetch(url);
    const text = await res.text();

    return {
      url,
      status: res.status,
      body: text,
      executedAt: new Date().toISOString(),
    };
  },

  "math.add": async (payload) => {
    const a = Number(payload.a);
    const b = Number(payload.b);

    if (isNaN(a) || isNaN(b)) {
      throw new Error("Invalid numbers for math.add");
    }

    return {
      a,
      b,
      result: a + b,
      executedAt: new Date().toISOString(),
    };
  },
};

//
// ---------------------------------------------------------------------------
// Connector Execution
// ---------------------------------------------------------------------------
//

async function executeConnector(
  connectorKey: string,
  payload: Record<string, unknown>,
): Promise<ConnectorResult> {
  const connector = connectorRegistry[connectorKey];

  if (!connector) {
    return {
      success: false,
      errorCode: "connector.not_found",
      errorMessage: `Connector '${connectorKey}' is not registered`,
    };
  }

  try {
    const output = await connector(payload);
    return {
      success: true,
      output,
    };
  } catch (err) {
    const message = err instanceof Error ? err.message : String(err);
    return {
      success: false,
      errorCode: "connector.execution_failed",
      errorMessage: message,
    };
  }
}

//
// ---------------------------------------------------------------------------
// HTTP Handler
// ---------------------------------------------------------------------------
//

serve(async (req) => {
  if (req.method !== "POST") {
    return new Response(
      JSON.stringify({ error: "Method not allowed" }),
      { status: 405, headers: { "Content-Type": "application/json" } },
    );
  }

  let context: ConnectorContext;

  try {
    context = await req.json();
  } catch {
    return new Response(
      JSON.stringify({
        success: false,
        errorCode: "connector.invalid_payload",
        errorMessage: "Invalid JSON payload",
      }),
      { status: 400, headers: { "Content-Type": "application/json" } },
    );
  }

  const { connectorKey, payload } = context;

  if (!connectorKey) {
    return new Response(
      JSON.stringify({
        success: false,
        errorCode: "connector.missing_key",
        errorMessage: "connectorKey is required",
      }),
      { status: 400, headers: { "Content-Type": "application/json" } },
    );
  }

  const result = await executeConnector(connectorKey, payload ?? {});

  return new Response(
    JSON.stringify(result),
    { status: 200, headers: { "Content-Type": "application/json" } },
  );
});
