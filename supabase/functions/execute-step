// supabase/functions/execute-step/index.ts
// Valtaris Glue — Unified Step Executor
//
// This replaces all legacy step execution paths.
// It is ONLY called by run-worker.
// It NEVER mutates workflow_runs directly.
// It NEVER bypasses workflow_versions.
// It NEVER executes connectors without idempotency keys.
//
// Authority chain:
//   run-worker → execute-step → connector → result

import { serve } from "https://deno.land/std@0.168.0/http/server.ts";

serve(async (req) => {
  const body = await req.json();
  const { name, payload, idempotencyKey } = body;

  if (!name) {
    return new Response("missing-task-name", { status: 400 });
  }

  // 1. Dispatch to connector bindings
  try {
    const result = await dispatchTask(name, payload, idempotencyKey);

    return new Response(JSON.stringify(result), {
      status: 200,
      headers: { "Content-Type": "application/json" },
    });
  } catch (err) {
    return new Response(
      JSON.stringify({ error: err.message }),
      { status: 500 }
    );
  }
});

// ----------------------------
// Task Dispatch
// ----------------------------

async function dispatchTask(name: string, payload: any, idempotencyKey: string) {
  // All connectors must be registered here.
  // This is the ONLY place tasks are executed.

  if (name.startsWith("http.")) {
    return await runHttpTask(name, payload, idempotencyKey);
  }

  if (name.startsWith("supabase.")) {
    return await runSupabaseTask(name, payload, idempotencyKey);
  }

  if (name.startsWith("ai.")) {
    return await runAiTask(name, payload, idempotencyKey);
  }

  throw new Error(`unknown-task: ${name}`);
}

// ----------------------------
// HTTP Connector
// ----------------------------

async function runHttpTask(name: string, payload: any, idempotencyKey: string) {
  const url = payload.url;
  const body = payload.body;

  switch (name) {
    case "http.get":
      return await fetch(url).then((r) => r.json());

    case "http.post":
      return await fetch(url, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body),
      }).then((r) => r.json());

    case "http.put":
      return await fetch(url, {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body),
      }).then((r) => r.json());

    case "http.delete":
      return await fetch(url, { method: "DELETE" }).then((r) => r.json());

    default:
      throw new Error(`unknown-http-task: ${name}`);
  }
}

// ----------------------------
// Supabase Connector
// ----------------------------

async function runSupabaseTask(name: string, payload: any, idempotencyKey: string) {
  const url = Deno.env.get("SUPABASE_URL")!;
  const key = Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!;
  const client = createClient(url, key);

  const { table, filters, values } = payload;

  switch (name) {
    case "supabase.select":
      return await client.from(table).select("*").match(filters);

    case "supabase.insert":
      return await client.from(table).insert(values).select();

    case "supabase.update":
      return await client.from(table).update(values).match(filters).select();

    case "supabase.delete":
      return await client.from(table).delete().match(filters).select();

    default:
      throw new Error(`unknown-supabase-task: ${name}`);
  }
}

// ----------------------------
// AI Connector
// ----------------------------

async function runAiTask(name: string, payload: any, idempotencyKey: string) {
  const apiKey = Deno.env.get("OPENAI_API_KEY")!;
  const { prompt } = payload;

  switch (name) {
    case "ai.generate":
      return await fetch("https://api.openai.com/v1/chat/completions", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Authorization: `Bearer ${apiKey}`,
        },
        body: JSON.stringify({
          model: "gpt-4o-mini",
          messages: [{ role: "user", content: prompt }],
        }),
      }).then((r) => r.json());

    default:
      throw new Error(`unknown-ai-task: ${name}`);
  }
}
