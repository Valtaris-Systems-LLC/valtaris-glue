// supabase/functions/execute-step/index.ts
// Valtaris Glue — Unified Step Executor (Generation 3)
//
// This file is the ONLY place where step execution happens.
// It is called exclusively by run-worker.
//
// It enforces:
// - version-pinned execution
// - idempotency key propagation
// - connector adapter isolation
// - structured error propagation
// - no direct mutation of workflow_runs
// - no bypass of workflow_versions
//
// Authority chain:
// run-worker → execute-step → connector-wrapper → adapter → external system

import { serve } from "https://deno.land/std@0.168.0/http/server.ts";
import { createClient } from "https://esm.sh/@supabase/supabase-js@2";

const supabase = createClient(
  Deno.env.get("SUPABASE_URL")!,
  Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!
);

serve(async (req) => {
  try {
    const body = await req.json();
    const {
      run_id,
      step_id,
      job_id,
      node,
      adapter,
      payload,
    } = body;

    if (!run_id || !step_id || !job_id || !node) {
      return jsonError("missing-required-fields", 400);
    }

    // Idempotency key is ALWAYS job_id
    const idempotencyKey = job_id;

    // Execute via connector-wrapper → adapter
    const result = await executeAdapter({
      run_id,
      step_id,
      job_id,
      node,
      adapter,
      payload,
      idempotencyKey,
    });

    return jsonOK({
      status: "step-executed",
      run_id,
      step_id,
      job_id,
      result,
    });
  } catch (err) {
    console.error("execute-step fatal error:", err);

    return jsonError("execute-step-failed", 500, {
      message: String(err),
      stack: err?.stack,
    });
  }
});

// ------------------------------------------------------------
// Adapter Execution
// ------------------------------------------------------------

async function executeAdapter({
  run_id,
  step_id,
  job_id,
  node,
  adapter,
  payload,
  idempotencyKey,
}: {
  run_id: string;
  step_id: string;
  job_id: string;
  node: any;
  adapter: string;
  payload: any;
  idempotencyKey: string;
}) {
  // All adapter execution flows through connector-wrapper
  const { data, error } = await supabase.functions.invoke("connector-wrapper", {
    body: {
      adapter,
      node,
      payload,
      idempotencyKey,
      run_id,
      step_id,
      job_id,
    },
  });

  if (error) {
    throw new Error(`Adapter execution failed: ${error}`);
  }

  return data;
}

// ------------------------------------------------------------
// Response Helpers
// ------------------------------------------------------------

function jsonOK(obj: any) {
  return new Response(JSON.stringify(obj), {
    status: 200,
    headers: { "Content-Type": "application/json" },
  });
}

function jsonError(code: string, status = 500, details?: any) {
  return new Response(
    JSON.stringify({
      error: code,
      details,
    }),
    {
      status,
      headers: { "Content-Type": "application/json" },
    }
  );
}
