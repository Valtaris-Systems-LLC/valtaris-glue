// supabase/functions/step-lifecycle/index.ts
// Valtaris Glue — Step Lifecycle Engine (Generation 3)
//
// This file is responsible for:
//   - marking steps completed
//   - marking steps failed
//   - marking steps approved / rejected
//   - marking steps compensated
//   - emitting lifecycle events
//   - triggering downstream scheduling
//
// Authority chain:
//   run-worker → step-lifecycle → schedule-next-job
//
// This file NEVER:
//   - executes connectors
//   - mutates workflow_versions
//   - creates jobs directly
//   - bypasses RLS

import { serve } from "https://deno.land/std@0.168.0/http/server.ts";
import { createClient } from "https://esm.sh/@supabase/supabase-js@2";

const supabase = createClient(
  Deno.env.get("SUPABASE_URL")!,
  Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!
);

serve(async (req) => {
  try {
    const body = await req.json();
    const { run_id, step_id, action, result, error } = body;

    if (!run_id || !step_id || !action) {
      return jsonError("missing-fields", 400);
    }

    const run = await loadRun(run_id);
    if (!run) return jsonError("run-not-found", 404);

    const version = await loadVersion(run.workflow_version_id);
    if (!version) return jsonError("version-not-found", 404);

    const node = version.graph.nodes.find((n: any) => n.id === step_id);
    if (!node) return jsonError("step-not-in-graph", 404);

    // Apply lifecycle action
    switch (action) {
      case "complete":
        await markCompleted(run_id, step_id, result);
        break;

      case "fail":
        await markFailed(run_id, step_id, error);
        break;

      case "approve":
        await markApproved(run_id, step_id);
        break;

      case "reject":
        await markRejected(run_id, step_id);
        break;

      case "compensate":
        await markCompensated(run_id, step_id, result);
        break;

      default:
        return jsonError("invalid-action", 400);
    }

    // Trigger downstream scheduling
    await supabase.functions.invoke("schedule-next-job", {
      body: { run_id },
    });

    return jsonOK({
      status: "step-updated",
      run_id,
      step_id,
      action,
    });
  } catch (err) {
    console.error("step-lifecycle fatal error:", err);
    return jsonError("step-lifecycle-failed", 500, err);
  }
});

// ------------------------------------------------------------
// Load Run + Version
// ------------------------------------------------------------

async function loadRun(runId: string) {
  const { data } = await supabase
    .from("workflow_runs")
    .select("*")
    .eq("id", runId)
    .single();
  return data ?? null;
}

async function loadVersion(versionId: string) {
  const { data } = await supabase
    .from("workflow_versions")
    .select("*")
    .eq("id", versionId)
    .single();
  return data ?? null;
}

// ------------------------------------------------------------
// Lifecycle Actions
// ------------------------------------------------------------

async function markCompleted(run_id: string, step_id: string, result: any) {
  await supabase.from("workflow_step_runs").insert({
    run_id,
    step_id,
    state: "completed",
    result,
    created_at: new Date(),
  });

  await emitEvent(run_id, step_id, "step.completed");
}

