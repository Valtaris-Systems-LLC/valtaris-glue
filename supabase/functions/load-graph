// supabase/functions/load-graph/index.ts
// Valtaris Glue — Unified Graph Loader (Generation 3)
//
// This file is responsible for:
//   - loading workflow graphs from workflow_versions
//   - validating graph structure
//   - validating node/edge integrity
//   - guaranteeing immutable graph usage across the entire runtime
//
// Authority chain:
//   execute-workflow → load-graph
//   run-worker → load-graph
//   replay-workflow → load-graph
//
// This file NEVER:
//   - reconstructs graphs
//   - loads workflow_dags
//   - loads workflow_definitions
//   - mutates workflow_versions
//   - executes connectors

import { serve } from "https://deno.land/std@0.168.0/http/server.ts";
import { createClient } from "https://esm.sh/@supabase/supabase-js@2";

const supabase = createClient(
  Deno.env.get("SUPABASE_URL")!,
  Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!
);

serve(async (req) => {
  try {
    const body = await req.json();
    const { workflow_version_id } = body;

    if (!workflow_version_id) {
      return jsonError("missing-workflow-version-id", 400);
    }

    // 1. Load workflow version (single authority)
    const version = await loadVersion(workflow_version_id);
    if (!version) return jsonError("version-not-found", 404);

    const graph = version.graph;

    // 2. Validate graph structure
    const validation = validateGraph(graph);
    if (!validation.valid) {
      return jsonError("invalid-graph-structure", 500, validation.errors);
    }

    // 3. Return immutable graph
    return jsonOK({
      workflow_version_id,
      graph,
      status: "ok",
    });
  } catch (err) {
    console.error("load-graph fatal error:", err);
    return jsonError("load-graph-failed", 500, err);
  }
});

// ------------------------------------------------------------
// Load Version
// ------------------------------------------------------------

async function loadVersion(versionId: string) {
  const { data } = await supabase
    .from("workflow_versions")
    .select("*")
    .eq("id", versionId)
    .single();

  return data ?? null;
}

// ------------------------------------------------------------
// Graph Validation
// ------------------------------------------------------------

function validateGraph(graph: any) {
  const errors: string[] = [];

  if (!graph || typeof graph !== "object") {
    errors.push("graph-missing");
    return { valid: false, errors };
  }

  if (!Array.isArray(graph.nodes)) {
    errors.push("nodes-missing");
    return { valid: false, errors };
  }

  const ids = new Set(graph.nodes.map((n: any) => n.id));

  for (const node of graph.nodes) {
    const id = node.id;

    // Validate node type
    if (!["task", "approval", "compensation"].includes(node.type)) {
      errors.push(`invalid-node-type: ${id}`);
    }

    // Validate edges
    validateEdgeList(errors, ids, node.next, id, "next");
    validateEdgeList(errors, ids, node.on_failure, id, "on_failure");
    validateEdgeList(errors, ids, node.on_approval, id, "on_approval");
    validateEdgeList(errors, ids, node.on_compensation, id, "on_compensation");

    // Validate connector reference
    if (node.connector && typeof node.connector !== "string") {
      errors.push(`invalid-connector: ${id}`);
    }
  }

  return {
    valid: errors.length === 0,
    errors,
  };
}

function validateEdgeList(
  errors: string[],
  ids: Set<string>,
  list: any,
  fromId: string,
  label: string
) {
  if (!Array.isArray(list)) return;

  for (const target of list) {
    if (!ids.has(target)) {
      errors.push(`invalid-edge: ${fromId} → ${target} (${label})`);
    }
  }
}

// ------------------------------------------------------------
// Response Helpers
// ------------------------------------------------------------

function jsonOK(obj: any) {
  return new Response(JSON.stringify(obj), {
    status: 200,
    headers: { "Content-Type": "application/json" },
  });
}

function jsonError(code: string, status = 500, details?: any) {
  return new Response(
    JSON.stringify({
      error: code,
      details,
    }),
    {
      status,
      headers: { "Content-Type": "application/json" },
    }
  );
}
