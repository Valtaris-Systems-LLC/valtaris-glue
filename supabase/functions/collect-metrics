// supabase/functions/collect-metrics/index.ts
// Valtaris Glue — Raw Metrics Collector (Generation 3)
//
// This file collects ALL raw metrics emitted by the runtime.
// It is intentionally simple, append-only, and high-throughput.
//
// Metrics collected:
//   - job execution duration
//   - step execution duration
//   - connector execution duration
//   - worker execution duration
//   - scheduler latency
//   - stuck-run events
//   - DLQ events
//   - repair events
//   - invariant violations
//
// Authority chain:
//   runtime → collect-metrics → workflow_metrics → aggregators → dashboards

import { serve } from "https://deno.land/std@0.168.0/http/server.ts";
import { createClient } from "https://esm.sh/@supabase/supabase-js@2";

const supabase = createClient(
  Deno.env.get("SUPABASE_URL")!,
  Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!
);

const NOW = () => new Date().toISOString();

serve(async (req) => {
  try {
    const body = await req.json();

    const {
      run_id,
      job_id,
      step_id,
      connector,
      event,
      duration_ms,
      error,
      metadata,
    } = body;

    if (!event) {
      return jsonError("missing-event", 400, "Metric event type is required");
    }

    const { error: insertErr } = await supabase
      .from("workflow_metrics")
      .insert({
        run_id,
        job_id,
        step_id,
        connector,
        event,
        duration_ms,
        error,
        metadata,
        created_at: NOW(),
      });

    if (insertErr) {
      return jsonError("metric-insert-failed", 500, insertErr);
    }

    return jsonOK({
      status: "metric-recorded",
      event,
    });
  } catch (err) {
    return jsonError("collect-metrics-failed", 500, String(err));
  }
});

// ------------------------------------------------------------
// Response Helpers
// ------------------------------------------------------------

function jsonOK(obj: any) {
  return new Response(JSON.stringify(obj), {
    status: 200,
    headers: { "Content-Type": "application/json" },
  });
}

function jsonError(code: string, status: number, details?: any) {
  return new Response(
    JSON.stringify({
      error: code,
      details,
    }),
    {
      status,
      headers: { "Content-Type": "application/json" },
    }
  );
}
