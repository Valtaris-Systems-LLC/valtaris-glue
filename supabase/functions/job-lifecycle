// supabase/functions/job-lifecycle/index.ts
// Valtaris Glue — Unified Job Lifecycle Engine
//
// This file centralizes ALL job lifecycle transitions.
// It ensures jobs move through deterministic, safe states:
//
//   pending → leased → running → completed
//   pending → leased → running → failed → dead_letter
//   pending → leased → running → failed → compensating
//
// It prevents:
//   - stuck jobs
//   - invalid transitions
//   - partial updates
//   - inconsistent state
//
// Authority chain:
//   worker-integrate → job-lifecycle → workflow_jobs

import { serve } from "https://deno.land/std@0.168.0/http/server.ts";
import { createClient } from "https://esm.sh/@supabase/supabase-js@2";

const supabase = createClient(
  Deno.env.get("SUPABASE_URL")!,
  Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!
);

serve(async (req) => {
  const body = await req.json();
  const { job_id, action, error } = body;

  if (!job_id || !action) {
    return new Response("missing-job-id-or-action", { status: 400 });
  }

  // 1. Load job
  const { data: job } = await supabase
    .from("workflow_jobs")
    .select("*")
    .eq("id", job_id)
    .single();

  if (!job) {
    return new Response("job-not-found", { status: 404 });
  }

  // 2. Determine lifecycle transition
  switch (action) {
    case "lease":
      return await leaseJob(job);

    case "start":
      return await startJob(job);

    case "complete":
      return await completeJob(job);

    case "fail":
      return await failJob(job, error);

    case "dead_letter":
      return await deadLetterJob(job, error);

    case "compensate":
      return await compensateJob(job);

    default:
      return new Response("invalid-action", { status: 400 });
  }
});

// ----------------------------
// Lifecycle Transitions
// ----------------------------

async function leaseJob(job: any) {
  if (job.state !== "pending") {
    return new Response("invalid-transition", { status: 400 });
  }

  await supabase
    .from("workflow_jobs")
    .update({
      state: "leased",
      claimed_at: new Date().toISOString(),
      lease_expires_at: new Date(Date.now() + 30000).toISOString(),
    })
    .eq("id", job.id);

  return new Response(
    JSON.stringify({ job_id: job.id, state: "leased" }),
    { status: 200 }
  );
}

async function startJob(job: any) {
  if (job.state !== "leased") {
    return new Response("invalid-transition", { status: 400 });
  }

  await supabase
    .from("workflow_jobs")
    .update({
      state: "running",
      started_at: new Date().toISOString(),
    })
    .eq("id", job.id);

  return new Response(
    JSON.stringify({ job_id: job.id, state: "running" }),
    { status: 200 }
  );
}

async function completeJob(job: any) {
  if (job.state !== "running") {
    return new Response("invalid-transition", { status: 400 });
  }

  await supabase
    .from("workflow_jobs")
    .update({
      state: "completed",
      completed_at: new Date().toISOString(),
    })
    .eq("id", job.id);

  return new Response(
    JSON.stringify({ job_id: job.id, state: "completed" }),
    { status: 200 }
  );
}

async function failJob(job: any, error: string) {
  if (job.state !== "running") {
    return new Response("invalid-transition", { status: 400 });
  }

  await supabase
    .from("workflow_jobs")
    .update({
      state: "failed",
      error,
      completed_at: new Date().toISOString(),
    })
    .eq("id", job.id);

  return new Response(
    JSON.stringify({ job_id: job.id, state: "failed", error }),
    { status: 200 }
  );
}

async function deadLetterJob(job: any, error: string) {
  await supabase
    .from("workflow_jobs")
    .update({
      state: "dead_letter",
      error,
      completed_at: new Date().toISOString(),
    })
    .eq("id", job.id);

  await supabase.from("workflow_dead_letters").insert({
    run_id: job.run_id,
    workflow_version_id: job.workflow_version_id,
    step_id: job.step_id,
    job_id: job.id,
    attempt: job.attempt,
    payload: job.payload,
    error,
    created_at: new Date().toISOString(),
  });

  return new Response(
    JSON.stringify({ job_id: job.id, state: "dead_letter", error }),
    { status: 200 }
  );
}

async function compensateJob(job: any) {
  await supabase
    .from("workflow_jobs")
    .update({
      state: "compensating",
      completed_at: new Date().toISOString(),
    })
    .eq("id", job.id);

  return new Response(
    JSON.stringify({ job_id: job.id, state: "compensating" }),
    { status: 200 }
  );
}
