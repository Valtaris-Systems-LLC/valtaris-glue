// supabase/functions/job-lifecycle/index.ts
// Valtaris Glue — Job Lifecycle Controller (Generation 3)
//
// This file enforces the durable job state machine:
//   pending → running → completed → failed → retrying → dead_letter
//
// It is called ONLY by run-worker.
// It NEVER mutates workflow_versions.
// It NEVER bypasses RLS.
// It ALWAYS writes workflow_step_runs + workflow_events.
// It ALWAYS preserves idempotency + version pinning.

import { serve } from "https://deno.land/std@0.168.0/http/server.ts";
import { createClient } from "https://esm.sh/@supabase/supabase-js@2";

const supabase = createClient(
  Deno.env.get("SUPABASE_URL")!,
  Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!
);

serve(async (req) => {
  try {
    const body = await req.json();
    const { job_id, action, error } = body;

    if (!job_id || !action) {
      return jsonError("missing-fields", 400);
    }

    const job = await loadJob(job_id);
    if (!job) return jsonError("job-not-found", 404);

    if (action === "complete") {
      return await handleComplete(job);
    }

    if (action === "fail") {
      return await handleFail(job, error);
    }

    return jsonError("unknown-action", 400);
  } catch (err) {
    console.error("job-lifecycle fatal error:", err);
    return jsonError("job-lifecycle-failed", 500, err);
  }
});

// ------------------------------------------------------------
// Load Job
// ------------------------------------------------------------

async function loadJob(jobId: string) {
  const { data } = await supabase
    .from("workflow_jobs")
    .select("*")
    .eq("id", jobId)
    .single();
  return data ?? null;
}

// ------------------------------------------------------------
// COMPLETE
// ------------------------------------------------------------

async function handleComplete(job: any) {
  // Mark job completed
  await supabase
    .from("workflow_jobs")
    .update({
      state: "completed",
      completed_at: new Date(),
    })
    .eq("id", job.id);

  // Step run record
  await supabase.from("workflow_step_runs").insert({
    run_id: job.run_id,
    step_id: job.step_id,
    job_id: job.id,
    state: "completed",
    created_at: new Date(),
  });

  // Workflow event
  await supabase.from("workflow_events").insert({
    run_id: job.run_id,
    step_id: job.step_id,
    type: "step.completed",
    created_at: new Date(),
  });

  return jsonOK({ status: "completed" });
}

// ------------------------------------------------------------
// FAIL (retry or dead-letter)
// ------------------------------------------------------------

async function handleFail(job: any, reason: string) {
  const attempt = job.attempt ?? 0;
  const nextAttempt = attempt + 1;
  const maxAttempts = 3;

  // Step run record
  await supabase.from("workflow_step_runs").insert({
    run_id: job.run_id,
    step_id: job.step_id,
    job_id: job.id,
    state: "failed",
    error: reason,
    created_at: new Date(),
  });

  // Workflow event
  await supabase.from("workflow_events").insert({
    run_id: job.run_id,
    step_id: job.step_id,
    type: "step.failed",
    error: reason,
    created_at: new Date(),
  });

  // Retry exhausted → dead-letter
  if (nextAttempt >= maxAttempts) {
    await supabase
      .from("workflow_jobs")
      .update({
        state: "dead_letter",
        completed_at: new Date(),
      })
      .eq("id", job.id);

    await supabase.from("workflow_dead_letter").insert({
      run_id: job.run_id,
      step_id: job.step_id,
      job_id: job.id,
      error: reason,
      created_at: new Date(),
    });

    await supabase.from("workflow_incidents").insert({
      run_id: job.run_id,
      step_id: job.step_id,
      type: "dlq",
      error: reason,
      created_at: new Date(),
    });

    return jsonOK({ status: "dead_letter" });
  }

  // Retry path
  const backoffMs = 5000;

  await supabase
    .from("workflow_jobs")
    .update({
      state: "retrying",
      attempt: nextAttempt,
      backoff_until: new Date(Date.now() + backoffMs),
    })
    .eq("id", job.id);

  return jsonOK({ status: "retrying", attempt: nextAttempt });
}

// ------------------------------------------------------------
// Response Helpers
// ------------------------------------------------------------

function jsonOK(obj: any) {
  return new Response(JSON.stringify(obj), {
    status: 200,
    headers: { "Content-Type": "application/json" },
  });
}

function jsonError(code: string, status = 500, err?: any) {
  return new Response(
    JSON.stringify({
      error: code,
      details: err ? String(err) : undefined,
    }),
    {
      status,
      headers: { "Content-Type": "application/json" },
    }
  );
}
