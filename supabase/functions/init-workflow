// supabase/functions/init-workflow/index.ts
// Valtaris Glue — Workflow Run Initializer (Generation 3)
//
// This file is responsible for:
//   - creating workflow_runs
//   - pinning workflow_version_id
//   - storing initial input
//   - emitting workflow.created events
//   - handing off to execute-workflow
//
// Authority chain:
//   workflow-publish → init-workflow → execute-workflow → ensure_downstream_job
//
// This file NEVER:
//   - executes connectors
//   - creates jobs
//   - mutates workflow_versions
//   - bypasses RLS

import { serve } from "https://deno.land/std@0.168.0/http/server.ts";
import { createClient } from "https://esm.sh/@supabase/supabase-js@2";

const supabase = createClient(
  Deno.env.get("SUPABASE_URL")!,
  Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!
);

serve(async (req) => {
  try {
    const body = await req.json();
    const { workflow_version_id, input } = body;

    if (!workflow_version_id) {
      return jsonError("missing-workflow-version-id", 400);
    }

    const version = await loadVersion(workflow_version_id);
    if (!version) return jsonError("version-not-found", 404);

    // Create run
    const run_id = crypto.randomUUID();

    await supabase.from("workflow_runs").insert({
      id: run_id,
      workflow_version_id,
      state: "created",
      input: input ?? {},
      created_at: new Date(),
    });

    // Emit workflow.created event
    await supabase.from("workflow_events").insert({
      run_id,
      step_id: null,
      type: "workflow.created",
      details: { workflow_version_id },
      created_at: new Date(),
    });

    // Immediately hand off to execute-workflow
    await supabase.functions.invoke("execute-workflow", {
      body: { run_id },
    });

    return jsonOK({
      status: "workflow-initialized",
      run_id,
      workflow_version_id,
    });
  } catch (err) {
    console.error("init-workflow fatal error:", err);
    return jsonError("init-workflow-failed", 500, err);
  }
});

// ------------------------------------------------------------
// Load Version
// ------------------------------------------------------------

async function loadVersion(versionId: string) {
  const { data } = await supabase
    .from("workflow_versions")
    .select("*")
    .eq("id", versionId)
    .single();
  return data ?? null;
}

// ------------------------------------------------------------
// Response Helpers
// ------------------------------------------------------------

function jsonOK(obj: any) {
  return new Response(JSON.stringify(obj), {
    status: 200,
    headers: { "Content-Type": "application/json" },
  });
}

function jsonError(code: string, status = 500, err?: any) {
  return new Response(
    JSON.stringify({
      error: code,
      details: err ? String(err) : undefined,
    }),
    {
      status,
      headers: { "Content-Type": "application/json" },
    }
  );
}
