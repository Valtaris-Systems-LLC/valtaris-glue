// supabase/functions/repair-stuck-run/index.ts
// Valtaris Glue — Stuck Run Repair Engine (Generation 3)

import { serve } from "https://deno.land/std@0.168.0/http/server.ts";
import { createClient } from "https://esm.sh/@supabase/supabase-js@2";

const supabase = createClient(
  Deno.env.get("SUPABASE_URL")!,
  Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!
);

const now = () => new Date();
const nowIso = () => new Date().toISOString();

serve(async () => {
  try {
    await repairExpiredLeases();
    await repairStuckRetrying();
    await repairExpiredApprovals();
    await repairRunsWithNoActiveJobs();

    return jsonOK({ status: "repair-complete" });
  } catch (err) {
    console.error("repair-stuck-run fatal:", err);
    return jsonError("repair-failed", 500, err);
  }
});

// ------------------------------------------------------------
// Expired leases → fail job
// ------------------------------------------------------------

async function repairExpiredLeases() {
  const { data: jobs } = await supabase
    .from("workflow_jobs")
    .select("*")
    .eq("state", "running")
    .lt("lease_expires_at", nowIso());

  if (!jobs?.length) return;

  for (const job of jobs) {
    await supabase.functions.invoke("job-lifecycle", {
      body: {
        job_id: job.id,
        action: "fail",
        error: "lease-expired",
      },
    });
  }
}

// ------------------------------------------------------------
// Stuck retrying → backoff expired
// ------------------------------------------------------------

async function repairStuckRetrying() {
  const { data: jobs } = await supabase
    .from("workflow_jobs")
    .select("*")
    .eq("state", "retrying")
    .lt("backoff_until", nowIso());

  if (!jobs?.length) return;

  for (const job of jobs) {
    await supabase
      .from("workflow_jobs")
      .update({
        state: "pending",
        scheduled_at: null,
      })
      .eq("id", job.id);
  }
}

// ------------------------------------------------------------
// Expired approvals → dead-letter job
// ------------------------------------------------------------

async function repairExpiredApprovals() {
  const { data: approvals } = await supabase
    .from("workflow_approvals")
    .select("*")
    .eq("state", "pending")
    .lt("expires_at", nowIso());

  if (!approvals?.length) return;

  for (const approval of approvals) {
    await supabase
      .from("workflow_approvals")
      .update({
        state: "expired",
        expired_at: now(),
      })
      .eq("id", approval.id);

    const jobId = await findJobId(approval.run_id, approval.step_id);

    if (jobId) {
      await supabase.functions.invoke("dead-letter", {
        body: {
          job_id: jobId,
          error: "approval-expired",
        },
      });
    }
  }
}

// ------------------------------------------------------------
// Runs with no active jobs → mark failed
// ------------------------------------------------------------

async function repairRunsWithNoActiveJobs() {
  const { data: runs } = await supabase
    .from("workflow_runs")
    .select("*")
    .eq("state", "running");

  if (!runs?.length) return;

  for (const run of runs) {
    const { data: active } = await supabase
      .from("workflow_jobs")
      .select("id")
      .eq("run_id", run.id)
      .in("state", ["pending", "running", "retrying", "delayed"]);

    if (!active?.length) {
      await supabase
        .from("workflow_runs")
        .update({
          state: "failed",
          completed_at: now(),
        })
        .eq("id", run.id);

      await supabase.from("workflow_incidents").insert({
        run_id: run.id,
        step_id: null,
        type: "run.stuck",
        error: "no-active-jobs",
        created_at: now(),
      });
    }
  }
}

// ------------------------------------------------------------
// Helper
// ------------------------------------------------------------

async function findJobId(runId: string, stepId: string) {
  const { data } = await supabase
    .from("workflow_jobs")
    .select("id")
    .eq("run_id", runId)
    .eq("step_id", stepId)
    .single();

  return data?.id ?? null;
}

// ------------------------------------------------------------
// Response Helpers
// ------------------------------------------------------------

function jsonOK(obj: any) {
  return new Response(JSON.stringify(obj), {
    status: 200,
    headers: { "Content-Type": "application/json" },
  });
}

function jsonError(code: string, status = 500, err?: any) {
  return new Response(
    JSON.stringify({
      error: code,
      details: err ? String(err) : undefined,
    }),
    {
      status,
      headers: { "Content-Type": "application/json" },
    }
  );
}
