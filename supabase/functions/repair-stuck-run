// supabase/functions/repair-stuck-run/index.ts
// Valtaris Glue — Stuck Run Repair Engine (Generation 3)
//
// Responsibilities:
//   - Detect stuck runs (no progress for too long)
//   - Detect runs with stalled jobs or step-runs
//   - Detect runs whose worker crashed mid-execution
//   - Reset run state safely
//   - Requeue the next job
//   - Ensure DAG consistency
//   - Preserve provenance
//
// Contract:
//   - Does NOT execute connectors
//   - Does NOT mutate workflow_versions
//   - Must be idempotent
//   - Called by check-invariants, stuck-run-detector, SLA sweeper

import { serve } from "https://deno.land/std@0.168.0/http/server.ts";
import { createClient } from "https://esm.sh/@supabase/supabase-js@2";

const supabase = createClient(
  Deno.env.get("SUPABASE_URL")!,
  Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!
);

const NOW = () => new Date();
const RUN_STUCK_MS = 10 * 60 * 1000; // 10 minutes

serve(async (req) => {
  const body = await req.json().catch(() => ({}));
  const { run_id } = body;

  if (!run_id) {
    return new Response("missing-run-id", { status: 400 });
  }

  // 1. Load run
  const { data: runData, error: runError } = await supabase
    .from("workflow_runs")
    .select("*")
    .eq("id", run_id)
    .single();

  if (runError || !runData) {
    return new Response("run-not-found", { status: 404 });
  }

  const run = runData;

  // 2. Load jobs + step-runs
  const jobs = await loadJobs(run_id);
  const steps = await loadSteps(run_id);

  // 3. Detect stuck run (no updates for too long)
  const lastUpdate = new Date(run.updated_at).getTime();
  const now = Date.now();
  const runIsStuck = now - lastUpdate > RUN_STUCK_MS;

  // 4. Detect stalled jobs
  const stalledJobs = jobs.filter(
    (j) =>
      j.state === "running" &&
      j.claimed_at &&
      now - new Date(j.claimed_at).getTime() > RUN_STUCK_MS
  );

  // 5. Detect stalled step-runs
  const stalledSteps = steps.filter(
    (s) =>
      s.state === "running" &&
      now - new Date(s.created_at).getTime() > RUN_STUCK_MS
  );

  if (!runIsStuck && stalledJobs.length === 0 && stalledSteps.length === 0) {
    return new Response(
      JSON.stringify({
        status: "run-not-stuck",
        run_id,
      }),
      { status: 200 }
    );
  }

  // 6. Reset run state
  const { error: resetError } = await supabase
    .from("workflow_runs")
    .update({
      state: "running",
      error: null,
      updated_at: new Date().toISOString(),
    })
    .eq("id", run_id);

  if (resetError) {
    console.error("reset-run-error", resetError);
    return new Response("run-reset-failed", { status: 500 });
  }

  // 7. Reset stalled jobs
  for (const job of stalledJobs) {
    await supabase
      .from("workflow_jobs")
      .update({
        state: "pending",
        claimed_at: null,
        lease_expires_at: null,
        error: null,
        updated_at: new Date().toISOString(),
      })
      .eq("id", job.id);
  }

  // 8. Reset stalled step-runs
  for (const step of stalledSteps) {
    await supabase
      .from("workflow_step_runs")
      .update({
        state: "pending",
        error: null,
        updated_at: new Date().toISOString(),
      })
      .eq("id", step.id);
  }

  // 9. Record provenance
  await supabase
    .from("workflow_run_repair")
    .insert({
      run_id,
      reason: runIsStuck
        ? "run-stuck"
        : stalledJobs.length > 0
        ? "stalled-jobs"
        : "stalled-steps",
      repaired_at: new Date().toISOString(),
    })
    .catch(() => {});

  // 10. Requeue next job
  await supabase.functions.invoke("schedule-next-job", {
    body: { run_id },
  });

  return new Response(
    JSON.stringify({
      status: "run-repaired",
      run_id,
      reason: runIsStuck
        ? "run-stuck"
        : stalledJobs.length > 0
        ? "stalled-jobs"
        : "stalled-steps",
    }),
    { status: 200 }
  );
});

// ------------------------------------------------------------
// Loaders
// ------------------------------------------------------------

async function loadJobs(run_id: string) {
  const { data } = await supabase
    .from("workflow_jobs")
    .select("*")
    .eq("run_id", run_id);
  return data ?? [];
}

async function loadSteps(run_id: string) {
  const { data } = await supabase
    .from("workflow_step_runs")
    .select("*")
    .eq("run_id", run_id);
  return data ?? [];
}
