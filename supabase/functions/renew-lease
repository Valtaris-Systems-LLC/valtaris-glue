// supabase/functions/renew-lease/index.ts
// Valtaris Glue — Worker Lease Renewal Engine (Generation 3)
//
// Durable execution requires lease renewal.
// Workers must periodically extend their lease on claimed jobs.
//
// Authority chain:
//   workflow_jobs.claimed_by → worker_id
//   workflow_jobs.lease_expires_at → extended
//
// If a worker fails to renew its lease:
//   - job becomes available again
//   - another worker can safely claim it
//
// This prevents:
//   - orphaned jobs
//   - stuck runs
//   - double execution
//   - inconsistent state

import { serve } from "https://deno.land/std@0.168.0/http/server.ts";
import { createClient } from "https://esm.sh/@supabase/supabase-js@2";

const supabase = createClient(
  Deno.env.get("SUPABASE_URL")!,
  Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!
);

// Lease duration (Generation‑3 standard)
const LEASE_MS = 1000 * 60 * 2; // 2 minutes

serve(async (req) => {
  try {
    const body = await req.json();
    const { worker_id } = body;

    if (!worker_id) {
      return jsonError("missing-worker-id", 400);
    }

    const newLease = new Date(Date.now() + LEASE_MS).toISOString();

    // Renew leases for all jobs claimed by this worker
    const { error } = await supabase
      .from("workflow_jobs")
      .update({
        lease_expires_at: newLease,
      })
      .eq("claimed_by", worker_id)
      .eq("state", "running");

    if (error) {
      console.error("lease-renewal-error:", error);
      return jsonError("lease-renewal-failed", 500, error);
    }

    // Emit lease-renewal event
    await supabase.from("workflow_events").insert({
      run_id: null,
      step_id: null,
      type: "worker.lease.renewed",
      details: { worker_id, renewed_until: newLease },
      created_at: new Date(),
    });

    return jsonOK({
      status: "lease-renewed",
      worker_id,
      renewed_until: newLease,
    });
  } catch (err) {
    console.error("renew-lease fatal error:", err);
    return jsonError("renew-lease-failed", 500, err);
  }
});

// ------------------------------------------------------------
// Response Helpers
// ------------------------------------------------------------

function jsonOK(obj: any) {
  return new Response(JSON.stringify(obj), {
    status: 200,
    headers: { "Content-Type": "application/json" },
  });
}

function jsonError(code: string, status = 500, details?: any) {
  return new Response(
    JSON.stringify({
      error: code,
      details,
    }),
    {
      status,
      headers: { "Content-Type": "application/json" },
    }
  );
}
