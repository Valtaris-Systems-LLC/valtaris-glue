// supabase/functions/connector-telemetry/index.ts
// Valtaris Glue — Connector Logging & Telemetry (Generation 3)
//
// This file records ALL connector activity:
//   - connector name
//   - idempotency key
//   - payload
//   - result
//   - error
//   - duration
//   - timestamp
//   - run_id
//   - job_id
//   - step_id
//
// This enables:
//   - debugging
//   - observability
//   - audit trails
//   - replay safety
//   - compensation analysis
//   - performance metrics
//
// Authority chain:
//   connector-wrapper → connector-telemetry → workflow_connector_logs

import { serve } from "https://deno.land/std@0.168.0/http/server.ts";
import { createClient } from "https://esm.sh/@supabase/supabase-js@2";

const supabase = createClient(
  Deno.env.get("SUPABASE_URL")!,
  Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!
);

const NOW = () => new Date().toISOString();

serve(async (req) => {
  try {
    const body = await req.json();

    const {
      connector,
      idempotencyKey,
      payload,
      result,
      error,
      durationMs,
      run_id,
      job_id,
      step_id,
    } = body;

    if (!connector || !idempotencyKey) {
      return jsonError("missing-connector-or-idempotency-key", 400);
    }

    // Insert telemetry log
    const { error: logErr } = await supabase
      .from("workflow_connector_logs")
      .insert({
        connector,
        idempotency_key: idempotencyKey,
        payload,
        result,
        error,
        duration_ms: durationMs,
        run_id,
        job_id,
        step_id,
        created_at: NOW(),
      });

    if (logErr) {
      return jsonError("telemetry-insert-failed", 500, logErr);
    }

    return jsonOK({
      status: "telemetry-recorded",
      connector,
      idempotencyKey,
    });
  } catch (err) {
    return jsonError("connector-telemetry-failed", 500, String(err));
  }
});

// ------------------------------------------------------------
// Response Helpers
// ------------------------------------------------------------

function jsonOK(obj: any) {
  return new Response(JSON.stringify(obj), {
    status: 200,
    headers: { "Content-Type": "application/json" },
  });
}

function jsonError(code: string, status: number, details?: any) {
  return new Response(
    JSON.stringify({
      error: code,
      details,
    }),
    {
      status,
      headers: { "Content-Type": "application/json" },
    }
  );
}
