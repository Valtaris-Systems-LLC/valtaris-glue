// supabase/functions/audit-run/index.ts
// Valtaris Glue — Workflow Run Consistency Audit (Generation 3)
//
// This file is responsible for:
//   - validating workflow run consistency
//   - validating step history correctness
//   - validating job history correctness
//   - validating DAG completeness
//   - validating terminal state correctness
//   - emitting audit events
//   - producing a clean audit record for replay + observability
//
// Authority chain:
//   finalize-run → audit-run → replay-workflow (optional)
//
// This file NEVER:
//   - executes connectors
//   - creates jobs
//   - mutates workflow_versions
//   - bypasses RLS

import { serve } from "https://deno.land/std@0.168.0/http/server.ts";
import { createClient } from "https://esm.sh/@supabase/supabase-js@2";

const supabase = createClient(
  Deno.env.get("SUPABASE_URL")!,
  Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!
);

serve(async (req) => {
  try {
    const body = await req.json();
    const { run_id } = body;

    if (!run_id) {
      return jsonError("missing-run-id", 400);
    }

    const run = await loadRun(run_id);
    if (!run) return jsonError("run-not-found", 404);

    const version = await loadVersion(run.workflow_version_id);
    if (!version) return jsonError("version-not-found", 404);

    const steps = await loadStepRuns(run_id);
    const jobs = await loadJobs(run_id);

    const audit = {
      run_id,
      terminal_state: run.state,
      step_count: steps.length,
      job_count: jobs.length,
      step_state_summary: summarizeStepStates(steps),
      job_state_summary: summarizeJobStates(jobs),
      dag_completeness: checkDagCompleteness(version, steps),
      terminal_state_valid: checkTerminalState(run, steps),
      created_at: new Date(),
    };

    // Emit audit event
    await supabase.from("workflow_events").insert({
      run_id,
      step_id: null,
      type: "run.audit",
      details: audit,
      created_at: new Date(),
    });

    // Store audit record
    await supabase.from("workflow_run_audits").insert(audit);

    return jsonOK({
      status: "audit-complete",
      audit,
    });
  } catch (err) {
    console.error("audit-run fatal error:", err);
    return jsonError("audit-run-failed", 500, err);
  }
});

// ------------------------------------------------------------
// Loaders
// ------------------------------------------------------------

async function loadRun(runId: string) {
  const { data } = await supabase
    .from("workflow_runs")
    .select("*")
    .eq("id", runId)
    .single();
  return data ?? null;
}

async function loadVersion(versionId: string) {
  const { data } = await supabase
    .from("workflow_versions")
    .select("*")
    .eq("id", versionId)
    .single();
  return data ?? null;
}

async function loadStepRuns(runId: string) {
  const { data } = await supabase
    .from("workflow_step_runs")
    .select("*")
    .eq("run_id", runId)
    .order("created_at", { ascending: true });
  return data ?? [];
}

async function loadJobs(runId: string) {
  const { data } = await supabase
    .from("workflow_jobs")
    .select("*")
    .eq("run_id", runId);
  return data ?? [];
}

// ------------------------------------------------------------
// Summaries
// ------------------------------------------------------------

function summarizeStepStates(steps: any[]) {
  const summary: Record<string, number> = {};
  for (const s of steps) {
    summary[s.state] = (summary[s.state] ?? 0) + 1;
  }
  return summary;
}

function summarizeJobStates(jobs: any[]) {
  const summary: Record<string, number> = {};
  for (const j of jobs) {
    summary[j.state] = (summary[j.state] ?? 0) + 1;
  }
  return summary;
}

// ------------------------------------------------------------
// DAG Completeness Check
// ------------------------------------------------------------

function checkDagCompleteness(version: any, steps: any[]) {
  const completed = new Set(
    steps.filter((s) => s.state === "completed").map((s) => s.step_id)
  );

  const missing: string[] = [];

  for (const node of version.graph.nodes) {
    if (!completed.has(node.id)) {
      missing.push(node.id);
    }
  }

  return {
    total_nodes: version.graph.nodes.length,
    completed_nodes: completed.size,
    missing_nodes: missing,
    complete: missing.length === 0,
  };
}

// ------------------------------------------------------------
// Terminal State Check
// ------------------------------------------------------------

function checkTerminalState(run: any, steps: any[]) {
  const failed = steps.some((s) => s.state === "failed");
  const completed = steps.every(
    (s) => s.state === "completed" || s.state === "approved"
  );

  if (run.state === "completed") {
    return completed;
  }

  if (run.state === "failed") {
    return failed;
  }

  if (run.state === "cancelled") {
    return true;
  }

  return false;
}

// ------------------------------------------------------------
// Response Helpers
// ------------------------------------------------------------

function jsonOK(obj: any) {
  return new Response(JSON.stringify(obj), {
    status: 200,
    headers: { "Content-Type": "application/json" },
  });
}

function jsonError(code: string, status = 500, details?: any) {
  return new Response(
    JSON.stringify({
      error: code,
      details,
    }),
    {
      status,
      headers: { "Content-Type": "application/json" },
    }
  );
}
