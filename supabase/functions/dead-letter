// supabase/functions/dead-letter/index.ts
// Valtaris Glue — Dead-Letter Queue Handler
//
// When a job exceeds max retries or encounters a fatal error,
// it must be moved to the dead-letter queue (DLQ).
//
// DLQ entries contain:
//   - run_id
//   - workflow_version_id
//   - step_id
//   - job_id
//   - attempt
//   - payload
//   - error
//   - timestamp
//
// This prevents:
//   - infinite retry loops
//   - stuck runs
//   - silent failures
//   - inconsistent state
//
// DLQ is the foundation for:
//   - compensation steps
//   - audit trails
//   - debugging
//   - safe recovery

import { serve } from "https://deno.land/std@0.168.0/http/server.ts";
import { createClient } from "https://esm.sh/@supabase/supabase-js@2";

const supabase = createClient(
  Deno.env.get("SUPABASE_URL")!,
  Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!
);

serve(async (req) => {
  const body = await req.json();
  const { job_id, error } = body;

  if (!job_id || !error) {
    return new Response("missing-job-or-error", { status: 400 });
  }

  // 1. Load job
  const { data: job } = await supabase
    .from("workflow_jobs")
    .select("*")
    .eq("id", job_id)
    .single();

  if (!job) {
    return new Response("job-not-found", { status: 404 });
  }

  // 2. Load run
  const { data: run } = await supabase
    .from("workflow_runs")
    .select("*")
    .eq("id", job.run_id)
    .single();

  if (!run) {
    return new Response("run-not-found", { status: 404 });
  }

  // 3. Insert DLQ entry
  const { error: dlqErr } = await supabase
    .from("workflow_dead_letters")
    .insert({
      run_id: run.id,
      workflow_version_id: run.workflow_version_id,
      step_id: job.step_id,
      job_id: job.id,
      attempt: job.attempt,
      payload: job.payload,
      error,
      created_at: new Date().toISOString(),
    });

  if (dlqErr) {
    return new Response("dlq-insert-failed", { status: 500 });
  }

  // 4. Mark job as failed
  await supabase
    .from("workflow_jobs")
    .update({
      state: "dead_letter",
      completed_at: new Date().toISOString(),
      error,
    })
    .eq("id", job.id);

  // 5. Mark run as failed (unless compensation is enabled)
  const compensationEnabled = run.compensation_enabled ?? false;

  if (!compensationEnabled) {
    await supabase
      .from("workflow_runs")
      .update({
        state: "failed",
        completed_at: new Date().toISOString(),
      })
      .eq("id", run.id);
  }

  return new Response(
    JSON.stringify({
      job_id,
      run_id: run.id,
      step_id: job.step_id,
      status: "dead_letter",
    }),
    { status: 200 }
  );
});
