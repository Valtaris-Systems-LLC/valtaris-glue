// supabase/functions/repair-run-finalize/index.ts
// Valtaris Glue — Run Finalization Repair Engine (Generation 3)
//
// Responsibilities:
//   - Ensure run reaches a correct terminal state
//   - Force-complete run when all jobs are completed
//   - Force-fail run when any job or step failed
//   - Validate DAG completion
//   - Validate job + step terminal states
//   - Emit finalization events
//   - Prepare run for archival or replay
//
// Contract:
//   - Does NOT execute connectors
//   - Does NOT mutate workflow_versions
//   - Must be idempotent
//   - Called by repair-run, lifecycle engines, stuck-run-detector

import { serve } from "https://deno.land/std@0.168.0/http/server.ts";
import { createClient } from "https://esm.sh/@supabase/supabase-js@2";

const supabase = createClient(
  Deno.env.get("SUPABASE_URL")!,
  Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!
);

const NOW = () => new Date();

serve(async (req) => {
  const body = await req.json().catch(() => ({}));
  const { run_id } = body;

  if (!run_id) {
    return new Response("missing-run-id", { status: 400 });
  }

  // 1. Load run
  const { data: runData, error: runError } = await supabase
    .from("workflow_runs")
    .select("*")
    .eq("id", run_id)
    .single();

  if (runError || !runData) {
    return new Response("run-not-found", { status: 404 });
  }

  const run = runData;

  // 2. Load jobs + steps
  const jobs = await loadJobs(run_id);
  const steps = await loadSteps(run_id);

  const allJobsCompleted = jobs.every((j) => j.state === "completed");
  const anyJobFailed = jobs.some((j) => j.state === "failed");

  const allStepsCompleted = steps.every((s) => s.state === "completed");
  const anyStepFailed = steps.some((s) => s.state === "failed");

  // 3. Determine correct terminal state
  let correctState = run.state;

  if (anyJobFailed || anyStepFailed) {
    correctState = "failed";
  } else if (allJobsCompleted && allStepsCompleted) {
    correctState = "completed";
  }

  // 4. If already correct, exit
  if (correctState === run.state) {
    return new Response(
      JSON.stringify({
        status: "run-finalization-correct",
        run_id,
        state: run.state,
      }),
      { status: 200 }
    );
  }

  // 5. Update run state
  const { error: updateError } = await supabase
    .from("workflow_runs")
    .update({
      state: correctState,
      updated_at: new Date().toISOString(),
    })
    .eq("id", run_id);

  if (updateError) {
    console.error("run-finalization-update-error", updateError);
    return new Response("run-finalization-update-failed", { status: 500 });
  }

  // 6. Emit finalization event
  await supabase
    .from("workflow_events")
    .insert({
      run_id,
      step_id: null,
      type:
        correctState === "completed"
          ? "run.finalized.completed"
          : "run.finalized.failed",
      details: {
        run_id,
        final_state: correctState,
      },
      created_at: NOW(),
    })
    .catch(() => {});

  // 7. Record provenance
  await supabase
    .from("workflow_run_finalization_repair")
    .insert({
      run_id,
      old_state: run.state,
      new_state: correctState,
      repaired_at: new Date().toISOString(),
    })
    .catch(() => {});

  return new Response(
    JSON.stringify({
      status: "run-finalized",
      run_id,
      old_state: run.state,
      new_state: correctState,
    }),
    { status: 200 }
  );
});

// ------------------------------------------------------------
// Loaders
// ------------------------------------------------------------

async function loadJobs(run_id: string) {
  const { data } = await supabase
    .from("workflow_jobs")
    .select("*")
    .eq("run_id", run_id);
  return data ?? [];
}

async function loadSteps(run_id: string) {
  const { data } = await supabase
    .from("workflow_step_runs")
    .select("*")
    .eq("run_id", run_id);
  return data ?? [];
}
