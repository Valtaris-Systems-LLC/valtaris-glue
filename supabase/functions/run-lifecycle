// supabase/functions/run-lifecycle/index.ts
// Valtaris Glue — Run Lifecycle Engine (Generation 3)
//
// This file is responsible for:
//   - transitioning workflow_runs between states
//   - marking runs completed / failed / cancelled
//   - emitting run lifecycle events
//   - ensuring correctness across job + step outcomes
//   - preventing stuck or invalid run states
//
// Authority chain:
//   step-lifecycle → run-lifecycle → finalize-run / repair-run
//
// This file NEVER:
//   - executes connectors
//   - creates jobs
//   - mutates workflow_versions
//   - bypasses RLS

import { serve } from "https://deno.land/std@0.168.0/http/server.ts";
import { createClient } from "https://esm.sh/@supabase/supabase-js@2";

const supabase = createClient(
  Deno.env.get("SUPABASE_URL")!,
  Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!
);

serve(async (req) => {
  try {
    const body = await req.json();
    const { run_id, action, error } = body;

    if (!run_id || !action) {
      return jsonError("missing-fields", 400);
    }

    const run = await loadRun(run_id);
    if (!run) return jsonError("run-not-found", 404);

    switch (action) {
      case "complete":
        await markCompleted(run_id);
        break;

      case "fail":
        await markFailed(run_id, error);
        break;

      case "cancel":
        await markCancelled(run_id);
        break;

      default:
        return jsonError("invalid-action", 400);
    }

    return jsonOK({
      status: "run-updated",
      run_id,
      action,
    });
  } catch (err) {
    console.error("run-lifecycle fatal error:", err);
    return jsonError("run-lifecycle-failed", 500, err);
  }
});

// ------------------------------------------------------------
// Load Run
// ------------------------------------------------------------

async function loadRun(runId: string) {
  const { data } = await supabase
    .from("workflow_runs")
    .select("*")
    .eq("id", runId)
    .single();
  return data ?? null;
}

// ------------------------------------------------------------
// Lifecycle Actions
// ------------------------------------------------------------

async function markCompleted(run_id: string) {
  await supabase
    .from("workflow_runs")
    .update({
      state: "completed",
      completed_at: new Date(),
    })
    .eq("id", run_id);

  await emitEvent(run_id, "run.completed");

  // Finalization hook
  await supabase.functions.invoke("finalize-run", {
    body: { run_id },
  });
}

async function markFailed(run_id: string, error: any) {
  await supabase
    .from("workflow_runs")
    .update({
      state: "failed",
      completed_at: new Date(),
      error,
    })
    .eq("id", run_id);

  await emitEvent(run_id, "run.failed");

  // Repair hook
  await supabase.functions.invoke("repair-run", {
    body: { run_id },
  });
}

async function markCancelled(run_id: string) {
  await supabase
    .from("workflow_runs")
    .update({
      state: "cancelled",
      completed_at: new Date(),
    })
    .eq("id", run_id);

  await emitEvent(run_id, "run.cancelled");
}

// ------------------------------------------------------------
// Event Helper
// ------------------------------------------------------------

async function emitEvent(run_id: string, type: string) {
  await supabase.from("workflow_events").insert({
    run_id,
    step_id: null,
    type,
    created_at: new Date(),
  });
}

// ------------------------------------------------------------
// Response Helpers
// ------------------------------------------------------------

function jsonOK(obj: any) {
  return new Response(JSON.stringify(obj), {
    status: 200,
    headers: { "Content-Type": "application/json" },
  });
}

function jsonError(code: string, status = 500, details?: any) {
  return new Response(
    JSON.stringify({
      error: code,
      details,
    }),
    {
      status,
      headers: { "Content-Type": "application/json" },
    }
  );
}
