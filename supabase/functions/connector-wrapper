// supabase/functions/connector-wrapper/index.ts
// Valtaris Glue — Connector Wrapper (Generation 3)
//
// This file is responsible for:
//   - executing connector adapters safely
//   - enforcing idempotency keys
//   - enforcing timeouts
//   - returning structured results
//   - returning structured errors
//   - isolating external systems
//
// Authority chain:
// execute-step → connector-wrapper → adapter → external system
//
// This file NEVER:
//   - mutates workflow_runs
//   - mutates workflow_versions
//   - bypasses RLS
//   - retries jobs
//   - logs step runs (execute-step does that)

import { serve } from "https://deno.land/std@0.168.0/http/server.ts";

const DEFAULT_TIMEOUT_MS = 30000; // 30 seconds

serve(async (req) => {
  try {
    const body = await req.json();
    const {
      adapter,
      run_id,
      step_id,
      job_id,
      node,
      payload,
      idempotencyKey,
    } = body;

    if (!adapter) {
      return jsonError("missing-adapter", 400);
    }

    const timeoutMs = node?.timeoutMs ?? DEFAULT_TIMEOUT_MS;

    const result = await executeAdapterWithTimeout(
      adapter,
      {
        run_id,
        step_id,
        job_id,
        node,
        payload,
        idempotencyKey,
      },
      timeoutMs
    );

    return jsonOK({
      status: "connector-executed",
      result,
    });
  } catch (err) {
    return jsonError("connector-wrapper-failed", 500, {
      message: String(err),
      stack: err?.stack,
    });
  }
});

// ------------------------------------------------------------
// Timeout Wrapper
// ------------------------------------------------------------

async function executeAdapterWithTimeout(
  adapter: string,
  args: any,
  timeoutMs: number
) {
  return await Promise.race([
    executeAdapter(adapter, args),
    timeoutPromise(timeoutMs),
  ]);
}

function timeoutPromise(ms: number) {
  return new Promise((_, reject) =>
    setTimeout(() => reject(new Error(`Connector timeout after ${ms}ms`)), ms)
  );
}

// ------------------------------------------------------------
// Adapter Execution
// ------------------------------------------------------------

async function executeAdapter(adapter: string, args: any) {
  const url = `https://valtaris-connectors.valtaris.dev/${adapter}`;

  const res = await fetch(url, {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      "X-Idempotency-Key": args.idempotencyKey,
    },
    body: JSON.stringify(args),
  });

  if (!res.ok) {
    const text = await res.text();
    throw new Error(`Adapter error (${res.status}): ${text}`);
  }

  return await res.json();
}

// ------------------------------------------------------------
// Response Helpers
// ------------------------------------------------------------

function jsonOK(obj: any) {
  return new Response(JSON.stringify(obj), {
    status: 200,
    headers: { "Content-Type": "application/json" },
  });
}

function jsonError(code: string, status = 500, details?: any) {
  return new Response(
    JSON.stringify({
      error: code,
      details,
    }),
    {
      status,
      headers: { "Content-Type": "application/json" },
    }
  );
}
