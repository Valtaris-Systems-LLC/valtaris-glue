// supabase/functions/connector-wrapper/index.ts
// Valtaris Glue — Connector Safety Wrapper
//
// ALL connector calls must flow through this wrapper.
// It enforces:
//   - idempotency
//   - timeout protection
//   - retry policy
//   - error normalization
//   - payload validation
//   - logging & telemetry
//
// Authority chain:
//   execute-step → connector-wrapper → idempotency → connector → normalized result

import { serve } from "https://deno.land/std@0.168.0/http/server.ts";
import { createClient } from "https://esm.sh/@supabase/supabase-js@2";

const supabase = createClient(
  Deno.env.get("SUPABASE_URL")!,
  Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!
);

// Timeout for connector calls
const TIMEOUT_MS = 1000 * 20; // 20 seconds

// Retry policy
const MAX_RETRIES = 2;

serve(async (req) => {
  const body = await req.json();
  const { connector, payload, idempotencyKey } = body;

  if (!connector || !idempotencyKey) {
    return new Response("missing-connector-or-idempotency-key", { status: 400 });
  }

  // 1. Check idempotency registry
  const { data: existing } = await supabase
    .from("workflow_idempotency")
    .select("*")
    .eq("key", idempotencyKey)
    .single();

  if (existing) {
    return new Response(
      JSON.stringify({
        idempotencyKey,
        result: existing.result,
        status: "duplicate",
      }),
      { status: 200 }
    );
  }

  // 2. Execute connector with retries + timeout
  let lastError = null;

  for (let attempt = 0; attempt <= MAX_RETRIES; attempt++) {
    try {
      const result = await executeWithTimeout(
        () => dispatchConnector(connector, payload),
        TIMEOUT_MS
      );

      // 3. Store idempotency result
      await supabase.from("workflow_idempotency").insert({
        key: idempotencyKey,
        result,
        created_at: new Date().toISOString(),
      });

      return new Response(
        JSON.stringify({
          idempotencyKey,
          result,
          status: "stored",
        }),
        { status: 200 }
      );
    } catch (err) {
      lastError = err;
    }
  }

  // 4. Return normalized error
  return new Response(
    JSON.stringify({
      idempotencyKey,
      error: normalizeError(lastError),
      status: "failed",
    }),
    { status: 500 }
  );
});

// ----------------------------
// Timeout wrapper
// ----------------------------

function executeWithTimeout(fn: () => Promise<any>, ms: number) {
  return new Promise((resolve, reject) => {
    const timer = setTimeout(() => reject(new Error("timeout")), ms);
    fn()
      .then((res) => {
        clearTimeout(timer);
        resolve(res);
      })
      .catch((err) => {
        clearTimeout(timer);
        reject(err);
      });
  });
}

// ----------------------------
// Connector dispatch
// ----------------------------

async function dispatchConnector(name: string, payload: any) {
  if (name.startsWith("http.")) {
    return await runHttpConnector(name, payload);
  }

  if (name.startsWith("supabase.")) {
    return await runSupabaseConnector(name, payload);
  }

  if (name.startsWith("ai.")) {
    return await runAiConnector(name, payload);
  }

  throw new Error(`unknown-connector: ${name}`);
}

// ----------------------------
// HTTP Connector
// ----------------------------

async function runHttpConnector(name: string, payload: any) {
  const { url, body } = payload;

  switch (name) {
    case "http.get":
      return await fetch(url).then((r) => r.json());

    case "http.post":
      return await fetch(url, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body),
      }).then((r) => r.json());

    case "http.put":
      return await fetch(url, {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body),
      }).then((r) => r.json());

    case "http.delete":
      return await fetch(url, { method: "DELETE" }).then((r) => r.json());

    default:
      throw new Error(`unknown-http-connector: ${name}`);
  }
}

// ----------------------------
// Supabase Connector
// ----------------------------

async function runSupabaseConnector(name: string, payload: any) {
  const url = Deno.env.get("SUPABASE_URL")!;
  const key = Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!;
  const client = createClient(url, key);

  const { table, filters, values } = payload;

  switch (name) {
    case "supabase.select":
      return await client.from(table).select("*").match(filters);

    case "supabase.insert":
      return await client.from(table).insert(values).select();

    case "supabase.update":
      return await client.from(table).update(values).match(filters).select();

    case "supabase.delete":
      return await client.from(table).delete().match(filters).select();

    default:
      throw new Error(`unknown-supabase-connector: ${name}`);
  }
}

// ----------------------------
// AI Connector
// ----------------------------

async function runAiConnector(name: string, payload: any) {
  const apiKey = Deno.env.get("OPENAI_API_KEY")!;
  const { prompt } = payload;

  switch (name) {
    case "ai.generate":
      return await fetch("https://api.openai.com/v1/chat/completions", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Authorization: `Bearer ${apiKey}`,
        },
        body: JSON.stringify({
          model: "gpt-4o-mini",
          messages: [{ role: "user", content: prompt }],
        }),
      }).then((r) => r.json());

    default:
      throw new Error(`unknown-ai-connector: ${name}`);
  }
}

// ----------------------------
// Error normalization
// ----------------------------

function normalizeError(err: any) {
  return {
    message: err?.message ?? "unknown-error",
    type: err?.name ?? "Error",
  };
}
