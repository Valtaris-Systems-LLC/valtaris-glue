// supabase/functions/load-definition/index.ts
// Valtaris Glue — Workflow Definition Loader (Generation 3)
//
// This file is responsible for:
//   - loading workflow definitions from workflow_versions
//   - validating graph structure
//   - validating connector references
//   - validating node types
//   - emitting workflow definition load events
//
// Authority chain:
//   workflow-publish → load-definition → init-workflow → execute-workflow
//
// This file NEVER:
//   - executes connectors
//   - mutates workflow_runs
//   - creates jobs
//   - bypasses RLS

import { serve } from "https://deno.land/std@0.168.0/http/server.ts";
import { createClient } from "https://esm.sh/@supabase/supabase-js@2";

const supabase = createClient(
  Deno.env.get("SUPABASE_URL")!,
  Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!
);

serve(async (req) => {
  try {
    const body = await req.json();
    const { version_id } = body;

    if (!version_id) {
      return jsonError("missing-version-id", 400);
    }

    const version = await loadVersion(version_id);
    if (!version) return jsonError("version-not-found", 404);

    const graph = version.graph;
    if (!graph || !Array.isArray(graph.nodes)) {
      return jsonError("invalid-graph", 400);
    }

    // Validate graph structure
    const validation = validateGraph(graph);
    if (!validation.valid) {
      return jsonError("graph-validation-failed", 400, validation.errors);
    }

    // Emit event
    await supabase.from("workflow_events").insert({
      run_id: null,
      step_id: null,
      type: "definition.loaded",
      details: { version_id },
      created_at: new Date(),
    });

    return jsonOK({
      status: "definition-loaded",
      version_id,
      nodes: graph.nodes.length,
      validation,
    });
  } catch (err) {
    console.error("load-definition fatal error:", err);
    return jsonError("load-definition-failed", 500, err);
  }
});

// ------------------------------------------------------------
// Load Version
// ------------------------------------------------------------

async function loadVersion(versionId: string) {
  const { data } = await supabase
    .from("workflow_versions")
    .select("*")
    .eq("id", versionId)
    .single();
  return data ?? null;
}

// ------------------------------------------------------------
// Graph Validation
// ------------------------------------------------------------

function validateGraph(graph: any) {
  const errors: string[] = [];
  const nodes = graph.nodes;

  const ids = new Set(nodes.map((n: any) => n.id));

  for (const node of nodes) {
    const id = node.id;

    // Validate node type
    if (!["task", "approval", "compensation"].includes(node.type)) {
      errors.push(`invalid-node-type: ${id}`);
    }

    // Validate next edges
    for (const nextId of node.next ?? []) {
      if (!ids.has(nextId)) {
        errors.push(`invalid-next-edge: ${id} → ${nextId}`);
      }
    }

    // Validate failure edges
    for (const failId of node.on_failure ?? []) {
      if (!ids.has(failId)) {
        errors.push(`invalid-failure-edge: ${id} → ${failId}`);
      }
    }

    // Validate approval edges
    for (const appId of node.on_approval ?? []) {
      if (!ids.has(appId)) {
        errors.push(`invalid-approval-edge: ${id} → ${appId}`);
      }
    }

    // Validate compensation edges
    for (const compId of node.on_compensation ?? []) {
      if (!ids.has(compId)) {
        errors.push(`invalid-compensation-edge: ${id} → ${compId}`);
      }
    }

    // Validate connector reference
    if (node.connector) {
      if (typeof node.connector !== "string") {
        errors.push(`invalid-connector: ${id}`);
      }
    }
  }

  return {
    valid: errors.length === 0,
    errors,
  };
}

// ------------------------------------------------------------
// Response Helpers
// ------------------------------------------------------------

function jsonOK(obj: any) {
  return new Response(JSON.stringify(obj), {
    status: 200,
    headers: { "Content-Type": "application/json" },
  });
}

function jsonError(code: string, status = 500, err?: any) {
  return new Response(
    JSON.stringify({
      error: code,
      details: err ? err : undefined,
    }),
    {
      status,
      headers: { "Content-Type": "application/json" },
    }
  );
}
