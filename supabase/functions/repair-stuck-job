// supabase/functions/repair-stuck-job/index.ts
// Valtaris Glue — Stuck Job Repair Engine (Generation 3)
//
// This file is responsible for:
//   - repairing jobs stuck in running/pending states
//   - repairing jobs with expired leases
//   - repairing jobs whose step-run is terminal
//   - repairing jobs that have not progressed
//   - emitting job repair events
//
// Authority chain:
//   stuck-run-detector → repair-stuck-job → repair-run → job-lifecycle / step-lifecycle
//
// This file NEVER:
//   - executes connectors
//   - mutates workflow_versions
//   - creates jobs directly
//   - bypasses RLS

import { serve } from "https://deno.land/std@0.168.0/http/server.ts";
import { createClient } from "https://esm.sh/@supabase/supabase-js@2";

const supabase = createClient(
  Deno.env.get("SUPABASE_URL")!,
  Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!
);

const NOW = () => new Date();
const NOW_ISO = () => new Date().toISOString();

const JOB_STUCK_MS = 1000 * 60 * 10; // 10 minutes

serve(async (req) => {
  try {
    const body = await req.json();
    const { job_id } = body;

    if (!job_id) {
      return jsonError("missing-job-id", 400);
    }

    const job = await loadJob(job_id);
    if (!job) return jsonError("job-not-found", 404);

    const steps = await loadStepRuns(job.run_id);

    await detectExpiredLease(job);
    await detectTerminalStep(job, steps);
    await detectJobStuck(job);

    return jsonOK({
      status: "repair-stuck-job-complete",
      job_id,
      run_id: job.run_id,
    });
  } catch (err) {
    console.error("repair-stuck-job fatal error:", err);
    return jsonError("repair-stuck-job-failed", 500, err);
  }
});

// ------------------------------------------------------------
// Loaders
// ------------------------------------------------------------

async function loadJob(jobId: string) {
  const { data } = await supabase
    .from("workflow_jobs")
    .select("*")
    .eq("id", jobId)
    .single();
  return data ?? null;
}

async function loadStepRuns(runId: string) {
  const { data } = await supabase
    .from("workflow_step_runs")
    .select("*")
    .eq("run_id", runId);
  return data ?? [];
}

// ------------------------------------------------------------
// Detection Logic
// ------------------------------------------------------------

async function detectExpiredLease(job: any) {
  if (job.state === "running" && job.lease_expires_at < NOW_ISO()) {
    await dispatchRepair("expired-lease", {
      run_id: job.run_id,
      job_id: job.id,
    });
  }
}

async function detectTerminalStep(job: any, steps: any[]) {
  const step = steps.find((s) => s.step_id === job.step_id);
  if (!step) return;

  if (["completed", "failed", "compensated", "approved", "rejected"].includes(step.state)) {
    await dispatchRepair("job-running-with-terminal-step", {
      run_id: job.run_id,
      job_id: job.id,
    });
  }
}

async function detectJobStuck(job: any) {
  if (job.state !== "running") return;

  const age = NOW().getTime() - new Date(job.started_at).getTime();
  if (age > JOB_STUCK_MS) {
    await dispatchRepair("job-running-without-progress", {
      run_id: job.run_id,
      job_id: job.id,
    });
  }
}

// ------------------------------------------------------------
// Repair Dispatcher
// ------------------------------------------------------------

async function dispatchRepair(type: string, payload: any) {
  await supabase.functions.invoke("repair-run", {
    body: { type, ...payload },
  });
}

// ------------------------------------------------------------
// Response Helpers
// ------------------------------------------------------------

function jsonOK(obj: any) {
  return new Response(JSON.stringify(obj), {
    status: 200,
    headers: { "Content-Type": "application/json" },
  });
}

function jsonError(code: string, status = 500, details?: any) {
  return new Response(
    JSON.stringify({
      error: code,
      details,
    }),
    {
      status,
      headers: { "Content-Type": "application/json" },
    }
  );
}
