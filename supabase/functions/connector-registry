// supabase/functions/connector-registry/index.ts
// Valtaris Glue — Connector Registry (Generation 3)
//
// This file is responsible for:
//   - defining available connectors
//   - defining connector metadata
//   - defining connector input schemas
//   - defining connector output schemas
//   - mapping connector keys → adapters
//   - exposing registry to UI + runtime
//
// Authority chain:
//   connector-runner → connector-registry → adapter metadata
//
// This file NEVER:
//   - executes connectors
//   - mutates workflow_runs
//   - mutates workflow_versions
//   - schedules jobs
//   - bypasses RLS

import { serve } from "https://deno.land/std@0.224.0/http/server.ts";

const NOW = () => new Date().toISOString();

// ---------------------------------------------------------------------------
// Generation‑3 Connector Registry
// ---------------------------------------------------------------------------
//
// This registry is intentionally simple and declarative.
// It is consumed by:
//   - connector-runner
//   - execute-step
//   - UI workflow builder
//   - governance + validation layers
//

const registry = {
  version: "3.0.0",
  updatedAt: NOW(),

  connectors: [
    {
      key: "echo",
      name: "Echo",
      category: "utility",
      adapter: "echo",
      description: "Returns the input payload unchanged.",
      inputSchema: {
        type: "object",
        additionalProperties: true,
      },
      outputSchema: {
        type: "object",
        properties: {
          echo: { type: "object" },
          executedAt: { type: "string" },
        },
      },
    },

    {
      key: "http.get",
      name: "HTTP GET",
      category: "http",
      adapter: "http.get",
      description: "Performs an HTTP GET request.",
      inputSchema: {
        type: "object",
        required: ["url"],
        properties: {
          url: { type: "string" },
        },
      },
      outputSchema: {
        type: "object",
        properties: {
          url: { type: "string" },
          status: { type: "number" },
          body: { type: "string" },
          executedAt: { type: "string" },
        },
      },
    },
  ],
};

// ---------------------------------------------------------------------------
// Handler
// ---------------------------------------------------------------------------

serve(async (req) => {
  try {
    const body = await safeJson(req);

    // If user requests a specific connector
    if (body?.key) {
      const connector = registry.connectors.find((c) => c.key === body.key);
      if (!connector) {
        return jsonError("connector-not-found", 404, `Connector '${body.key}' not found`);
      }

      return jsonOK({
        status: "connector-metadata",
        connector,
      });
    }

    // Otherwise return full registry
    return jsonOK({
      status: "registry",
      registry,
    });
  } catch (err) {
    return jsonError("registry-failed", 500, String(err));
  }
});

// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------

async function safeJson(req: Request) {
  try {
    return await req.json();
  } catch {
    return null;
  }
}

function jsonOK(obj: any) {
  return new Response(JSON.stringify(obj), {
    status: 200,
    headers: { "Content-Type": "application/json" },
  });
}

function jsonError(code: string, status: number, message?: string) {
  return new Response(
    JSON.stringify({
      error: code,
      message,
    }),
    {
      status,
      headers: { "Content-Type": "application/json" },
    }
  );
}
