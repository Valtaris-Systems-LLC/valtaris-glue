// src/components/workflow/WorkflowStepList.tsx
// Valtaris Glue — Workflow Step List
//
// Displays:
// - all steps in a workflow run
// - step state (pending, running, completed, failed)
// - timestamps
// - expandable details
//
// This is the main UI component for viewing workflow execution steps.

import React, { useState } from "react";

export interface WorkflowStep {
  id: string;
  type: string;
  state: string;
  startedAt?: string;
  completedAt?: string;
  payload?: Record<string, unknown>;
}

interface WorkflowStepListProps {
  steps: WorkflowStep[];
}

export function WorkflowStepList({ steps }: WorkflowStepListProps) {
  const [expanded, setExpanded] = useState<string | null>(null);

  const toggle = (id: string) => {
    setExpanded(expanded === id ? null : id);
  };

  return (
    <div className="space-y-3">
      {steps.map((step) => (
        <div
          key={step.id}
          className="border rounded-lg p-3 bg-white shadow-sm hover:shadow-md transition"
        >
          <div className="flex justify-between items-center">
            <div>
              <h3 className="font-semibold text-gray-800">{step.id}</h3>
              <p className="text-sm text-gray-600">{step.type}</p>
            </div>

            <span
              className={`px-2 py-1 rounded text-sm ${
                step.state === "completed"
                  ? "bg-green-100 text-green-700"
                  : step.state === "failed"
                  ? "bg-red-100 text-red-700"
                  : step.state === "running"
                  ? "bg-blue-100 text-blue-700"
                  : "bg-gray-100 text-gray-700"
              }`}
            >
              {step.state}
            </span>
          </div>

          <div className="text-xs text-gray-500 mt-2 space-y-1">
            {step.startedAt && <p>Started: {step.startedAt}</p>}
            {step.completedAt && <p>Completed: {step.completedAt}</p>}
          </div>

          <button
            onClick={() => toggle(step.id)}
            className="mt-2 text-blue-600 hover:text-blue-800 text-sm"
          >
            {expanded === step.id ? "Hide Details" : "Show Details"}
          </button>

          {expanded === step.id && (
            <pre className="mt-3 bg-gray-50 p-3 rounded text-xs overflow-auto">
              {JSON.stringify(step.payload ?? {}, null, 2)}
            </pre>
          )}
        </div>
      ))}
    </div>
  );
}
